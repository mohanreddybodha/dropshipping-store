{
  "name": "storefront",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-port.js && next dev",
    "build": "node -e \"const fs = require('fs'); try { fs.rmSync('.next', { recursive: true, force: true }); } catch (e) {}\" && next build",
    "start": "node scripts/ensure-port.js && next start",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true });\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
