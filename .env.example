# CJ Dropshipping API Credentials
CJ_API_KEY=your_cj_api_key_here

# Target Destination Country (US for Global, IN for India)
TARGET_COUNTRY_CODE=US

# Database Connection (SQLite default for local dev, or Supabase PostgreSQL)
# Local SQLite: sqlite:///data/ecommerce.db
# Supabase PostgreSQL: postgresql+psycopg2://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///data/ecommerce.db

# Cryptographic Webhook Signing Secret (HMAC-SHA256)
WEBHOOK_SECRET=your_webhook_signing_secret_here

# Admin API Key for Operations & DLQ Management
ADMIN_API_KEY=your_admin_secret_api_key_here

# Printify API Credentials (Optional)
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
